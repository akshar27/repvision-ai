# Backend (prefix REPVISION_) - copy to .env at the repo root
REPVISION_POSE_MODEL=full            # lite | full | heavy (heavy must be downloaded: scripts/download_models.py heavy)
REPVISION_MAX_UPLOAD_MB=300
REPVISION_MAX_VIDEO_SECONDS=600
REPVISION_INFERENCE_MAX_SIDE=640     # frames are downscaled to this for the pose model; annotation stays full-res
REPVISION_FRAME_STRIDE=1             # run pose every Nth frame (overlay reuses the last result)
REPVISION_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REPVISION_WORKER_THREADS=1

# Frontend (set in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
